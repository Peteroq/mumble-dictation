# SwiftPM and Xcode products. The Makefile stages the real bundle in
# ~/Library/Caches/MumbleBuild; anything that still lands in the tree is noise.
.build/
**/.build/
.swiftpm/
**/DerivedData/
*.dSYM/
*.xcarchive
*.xcuserdatad
*.xcuserdata
*.xcuserstate

# Release zips. The macOS app workflow writes
# dist/Mumble-<version>-<sha>-arm64.zip and uploads that zip as the artifact.
dist/
*.zip

# Built .app bundles at the repo root only.
# An unanchored `*.app/` also matches windows/src/Mumble.App/ on a
# case-insensitive volume and would hide the Avalonia project.
/*.app/

# .NET build output
[Bb]in/
[Oo]bj/
.vs/
artifacts/
*.binlog
*.user

# Model weights fetched outside the repo. Large, and not source.
models/
*.onnx
*.nemo

# Icon binaries regenerated by `make icon`.
Resources/AppIcon.icns
Resources/AppIcon.iconset/

.DS_Store
