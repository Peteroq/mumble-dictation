# macOS build
.build/
*.xcuserdatad
.DS_Store

# Zipped app produced for a GitHub Release. The workflow writes it; it is not source.
/dist/

# Built .app bundles, at the repo root ONLY.
#
# Anchored deliberately. An unanchored `*.app/` also matches `windows/src/Mumble.App/`,
# because macOS filesystems are case-insensitive — which silently kept the entire Avalonia
# app out of the repo until a CI publish step failed to find the project file.
/*.app/

# Windows / .NET build
[Bb]in/
[Oo]bj/
*.user
.vs/
artifacts/

# Local ASR model weights. Large, redistributed under their own license, and every
# platform fetches them itself — see docs/PARAKEET-WINDOWS.md.
models/
*.onnx
*.nemo
