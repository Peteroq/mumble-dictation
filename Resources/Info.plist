<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Mumble</string>
	<key>CFBundleDisplayName</key>
	<string>Mumble</string>
	<!-- Deliberately space-free and distinct from the existing app's `murmur`, so that
	     `pkill`/`killall` on either app can never match the other. -->
	<key>CFBundleExecutable</key>
	<string>Mumble</string>
	<!-- Separate from the existing Murmur's com.murmur.client: distinct TCC identity,
	     distinct preferences domain, no shared state of any kind. -->
	<key>CFBundleIdentifier</key>
	<string>ai.pivotstudio.mumble</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<!-- Lets the dashboard's Clear button call back into the app. A file:// page can't
	     write files or talk to a process, but it can follow a custom-scheme link. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ai.pivotstudio.mumble</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- Not bare "mumble" — the open-source Mumble VoIP client already owns the
				     mumble:// scheme, and a collision there would hijack its links or vice versa. -->
				<string>mumble-dictation</string>
			</array>
		</dict>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<!-- A regular app: dock icon, app menu, standard windows. The menu bar item remains
	     for status and the hotkey while you're working elsewhere, but it is secondary. -->
	<key>LSUIElement</key>
	<false/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Mumble listens while you hold the push-to-talk key so it can turn your speech into text.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Mumble transcribes your speech on-device to insert text where you're typing.</string>
</dict>
</plist>
